&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;スペイン vs カーボベルデ&lt;/td&gt;
&lt;td&gt;6月15日&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;ウルグアイ vs サウジアラビア&lt;/td&gt;
&lt;td&gt;6月16日&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;スペイン vs ウルグアイ&lt;/td&gt;
&lt;td&gt;6月21日&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;サウジアラビア vs カーボベルデ&lt;/td&gt;
&lt;td&gt;6月22日&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;サウジアラビア vs スペイン&lt;/td&gt;
&lt;td&gt;6月27日&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;カーボベルデ vs ウルグアイ&lt;/td&gt;
&lt;td&gt;6月27日&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;</description></item></channel></rss>